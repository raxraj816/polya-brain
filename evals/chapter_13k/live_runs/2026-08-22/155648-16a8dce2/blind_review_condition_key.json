            "execute check verify with Path and assert trace-line",
            "run check verify and verify writer trace-line writes to disk"
          ],
          "name": "path_write_roundtrip"
        }
      ],
      "required_correction_concepts": [
        {
          "any_of": [
            "open output instead of output_path",
            "capture and use the output argument in the writer",
            "replace the undefined output_path reference with output"
          ],
          "name": "use_output_argument"
        }
      ],
      "required_mechanism_concepts": [
        {
          "any_of": [
            "output_path is undefined",
            "the closure references an unbound output_path",
            "the closure never binds output_path",
