          "name": "unguarded_wrong_scheme"
        }
      ]
    },
    "fastapi_skip_defaults": {
      "forbidden_conclusions": [
        "drop all fields whose value is none unconditionally"
      ],
      "required_check_concepts": [
        {
          "any_of": [
            "test that skip true omits note and skip false includes it",
            "verify both skip_defaults settings",
            "assert name only when true and note none when false"
          ],
          "name": "skip_true_and_false"
        }
      ],
      "required_correction_concepts": [
        {
          "any_of": [
            "call response.dict with skip_defaults before encoding",
            "use the model serialization path when skip_defaults is true",
            "preserve the response model until defaults are excluded"
          ],
          "name": "serialize_from_model"
        }
      ],
      "required_mechanism_concepts": [
        {
          "any_of": [
            "the model is flattened to a plain dictionary before skip-default serialization",
            "default semantics are lost when response becomes a dict",
            "skip_defaults is never applied through the response model"
          ],
          "name": "model_metadata_lost"
        }
      ]
    },
    "fastapi_websocket_router": {
      "forbidden_conclusions": [
