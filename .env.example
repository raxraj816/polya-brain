# Local environment template for PolyaBrain.
# Copy this file to .env for local development. Do not commit real secrets.

# Optional direct baseline runner.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Future backend settings.
POLYABRAIN_ENV=local
POLYABRAIN_LOG_LEVEL=INFO
POLYABRAIN_SECRET_KEY=
POLYABRAIN_SESSION_RUN_TIMEOUT_SECONDS=900

# Future local services.
DATABASE_URL=postgresql+psycopg://polyabrain:polyabrain@localhost:5432/polyabrain
REDIS_URL=redis://localhost:6379/0

# Future search/research provider placeholder.
SEARCH_PROVIDER=
SEARCH_API_KEY=
