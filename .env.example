# Local environment template for PolyaBrain.
# Copy this file to .env for local development. Do not commit real secrets.

# Optional direct baseline runner.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Non-confidential evaluation model. This free endpoint cannot satisfy the
# fail-closed privacy and strict JSON routing defaults below.
OPENROUTER_MODEL=openrouter/auto
# Optional single fallback used only for typed retryable or schema failures.
# PolyaBrain never discovers or silently adds model routes at runtime.
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_APP_URL=
OPENROUTER_APP_TITLE=PolyaBrain
# Restrict routing to providers that do not collect prompts for training/storage.
OPENROUTER_DATA_COLLECTION=deny
# Enable only when the configured model has a Zero Data Retention endpoint.
OPENROUTER_ZDR=false
# Fail closed unless the selected endpoint declares JSON-mode support.
OPENROUTER_REQUIRE_PARAMETERS_FOR_JSON=true

# Optional direct-model proof baseline.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Backend settings.
POLYABRAIN_ENV=local
POLYABRAIN_LOG_LEVEL=INFO
# Required (32+ random characters) for OIDC state signing when auth is enabled.
POLYABRAIN_SECRET_KEY=
# Bypass is allowed only for local/test. Public deployments require true.
POLYABRAIN_AUTH_REQUIRED=false
POLYABRAIN_PUBLIC_ORIGIN=
POLYABRAIN_AUTH_SESSION_SECONDS=3600
# Authenticated API only: UTC daily starts/resumes, conservatively including failures.
POLYABRAIN_DAILY_USER_RUN_LIMIT=20
POLYABRAIN_DAILY_GLOBAL_RUN_LIMIT=100
POLYABRAIN_CONCURRENT_USER_RUN_LIMIT=1
POLYABRAIN_CONCURRENT_GLOBAL_RUN_LIMIT=4
# Authenticated API only: successful UTC daily storage writes. Zero closes writes.
# Ordinary and source/check creation share the session allowance.
POLYABRAIN_DAILY_USER_SESSION_LIMIT=50
POLYABRAIN_DAILY_GLOBAL_SESSION_LIMIT=500
POLYABRAIN_DAILY_USER_FEEDBACK_LIMIT=100
POLYABRAIN_DAILY_GLOBAL_FEEDBACK_LIMIT=1000
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Comma-separated provider subject IDs explicitly admitted to the private beta.
OIDC_ALLOWED_SUBJECTS=
# Explicitly enable public identity-provider signup admission; invite_only is default.
OIDC_REGISTRATION_MODE=invite_only
# Exact provider subject IDs denied at login and on every authenticated request.
OIDC_BLOCKED_SUBJECTS=
POLYABRAIN_SESSION_RUN_TIMEOUT_SECONDS=900
POLYABRAIN_CLARIFICATION_TIMEOUT_SECONDS=86400

# Future local services.
DATABASE_URL=postgresql+psycopg://polyabrain:polyabrain@localhost:5432/polyabrain
REDIS_URL=redis://localhost:6379/0

# Optional bounded web research. Raw results are evaluated before evidence use.
# Choose brave (SEARCH_API_KEY) or openrouter (existing OPENROUTER_API_KEY/MODEL).
# OpenRouter uses one Exa server search per request; model and search usage count.
# Only source annotation excerpts enter evaluation, never the generated answer.
# Leave blank to disable online research. CLI --offline always disables it.
SEARCH_PROVIDER=
SEARCH_API_KEY=
SEARCH_BASE_URL=https://api.search.brave.com/res/v1/web/search
RESEARCH_MAX_QUERIES=3
RESEARCH_MAX_RESULTS_PER_QUERY=5
RESEARCH_MAX_TOTAL_CANDIDATES=15

# Optional explicit local artifact inspection. Separate roots using the OS path separator.
# Only referenced UTF-8 text files contained by these roots can be read.
ARTIFACT_ALLOWED_ROOTS=
ARTIFACT_MAX_FILE_BYTES=1000000

# Optional isolated code execution. Requires access to a trusted Docker daemon.
CODE_EXECUTION_ENABLED=false
CODE_EXECUTION_IMAGE=python:3.14-alpine@sha256:a1321512d6a287428c50dcdf2ab3857761127e03a23b1f648e9c1c0de59288f8
CODE_EXECUTION_TIMEOUT_SECONDS=5
CODE_EXECUTION_MEMORY_MB=64
# With code execution enabled, self-contained "Implement f(...) -> T" tasks use
# lean-first differential verification: an independent oracle, randomized
# comparison and adjudicated repair. Set false to route them through the kernel.
VERIFIED_CODING_ENABLED=true
# Failure-pattern memory: confirmed defects are stored locally and retrieved as
# verification hints (never as requirements). Set false to disable learning.
FAILURE_PATTERNS_ENABLED=true
FAILURE_PATTERNS_PATH=runs/memory/failure_patterns.jsonl
# PolyaBrain Reader reads Wikipedia/Wikidata directly (no model, no search vendor).
# Wikimedia allows 10 requests/minute without contact details and 200/minute when
# the User-Agent names a contact URL or email (operator's choice), e.g.
# READER_CONTACT=https://example.org/polyabrain; ops@example.org
READER_CONTACT=
READER_CACHE_DIR=runs/reader-cache
