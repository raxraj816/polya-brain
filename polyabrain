#!/usr/bin/env python3
"""Repository entrypoint: use the local runtime and preserve explicit proof mode."""

import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent
VENV = ROOT / ".venv"
if (VENV / "bin/python").is_file() and Path(sys.prefix).resolve() != VENV.resolve():
    os.execv(str(VENV / "bin/python"), [str(VENV / "bin/python"), str(__file__), *sys.argv[1:]])

if sys.version_info[:2] != (3, 14):
    raise SystemExit("PolyaBrain requires Python 3.14. Run make setup with Python 3.14 first.")

sys.path.insert(0, str(ROOT / "backend"))
if len(sys.argv) > 1 and sys.argv[1] == "proof":
    from proofs.pre_platform.cli import main

    main()
else:
    from app.investigator.cli import main

    raise SystemExit(main())
